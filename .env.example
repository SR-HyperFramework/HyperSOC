# Compose database and backend publication. PostgreSQL stays private by default.
POSTGRES_USER=soc
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=soc
DATABASE_URL=postgresql+asyncpg://soc:replace-with-a-random-database-password@postgres:5432/soc
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000

# Generate a random value of at least 16 characters and configure the same value
# in Wazuh <api_key>. The documented placeholder is rejected at startup.
APP_SECRET_KEY=replace-with-a-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
AUTH_ENABLED=true
AUTH_SESSION_SECONDS=3600
# Per direct client IP, per backend process. Benchmarks override this locally.
SECURITY_RATE_LIMIT_PER_MINUTE=120
INGEST_SIGNATURE_MAX_SKEW_SECONDS=300
INGEST_MAX_BODY_BYTES=1048576
# Optional per-source Hub HMAC keys, as a JSON object. If set, unlisted sources
# are rejected and APP_SECRET_KEY cannot authenticate their Hub events.
# HUB_SOURCE_KEYS={"edr-prod":"a-long-unique-secret","wazuh":"another-unique-secret"}
HUB_SOURCE_KEYS=

# Durable SOC pipeline. Run the Compose worker with the backend.
AUTOMATION_ENABLED=true
AUTOMATION_POLL_SECONDS=2
AUTOMATION_LEASE_SECONDS=300
AUTOMATION_MAX_ATTEMPTS=5
# Learn from prior behavior telemetry; fewer than 20 records yields an explicit gap.
BEHAVIOR_AUTO_TRAIN=true
BEHAVIOR_REFRESH_SECONDS=3600
BEHAVIOR_TRAINING_DAYS=30
# Optional grounded alert summaries using the investigator's OpenRouter model/key.
ALERT_UNDERSTANDING_PROVIDER_MODE=offline

# External Wazuh manager sends outbound HTTPS requests to this published endpoint.
# This is documentation/configuration for the manager, not a backend client URL.
SOC_INGEST_URL=https://soc.example.internal/api/v1/alerts

# Placeholder settings for later roadmap phases.
WAZUH_API_URL=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
WAZUH_API_VERIFY_TLS=true
WAZUH_ACTIVE_RESPONSE_PROVIDER_MODE=offline
# Real Wazuh mode requires explicit numeric IDs such as 001,002; offline mode may use all.
WAZUH_ACTIVE_RESPONSE_AGENTS=all
WAZUH_ACTIVE_RESPONSE_COMMAND=firewall-drop
WAZUH_ACTIVE_RESPONSE_TIMEOUT_SECONDS=10
RESPONSE_EVIDENCE_SOURCES=wazuh
# Set AI_TRIAGE_PROVIDER_MODE=jev to enable TypeSafe System One triage.
# Direct TypeSafe: use a key from https://console.typesafe.ai and leave BASE_URL empty.
# OpenRouter: use an OpenRouter key, BASE_URL=https://openrouter.ai/api,
# and MODEL=jev-1.13. Keep the key in a private .env; never commit it.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=jev-latest
AI_TRIAGE_PROVIDER_MODE=offline
AI_TRIAGE_TIMEOUT_SECONDS=30
AI_TRIAGE_MAX_ALERTS=25
AI_TRIAGE_MAX_TEXT_CHARS=1000
AI_TRIAGE_MAX_CONTEXT_CHARS=20000
AI_TRIAGE_MAX_JSON_DEPTH=6
AI_TRIAGE_MAX_LIST_ITEMS=50
AI_TRIAGE_BINARY_PLACEHOLDER=[BINARY_DATA_STRIPPED]
# Optional investigator assistant. Offline mode records evidence without an LLM.
# OpenRouter mode makes two structured-output requests per run: tool plan and cited report.
# Use a model/provider endpoint that supports JSON-schema structured outputs.
# If TYPESAFE_BASE_URL points to OpenRouter, TYPESAFE_API_KEY can be reused automatically.
INVESTIGATOR_PROVIDER_MODE=offline
INVESTIGATOR_OPENROUTER_API_KEY=
INVESTIGATOR_MODEL=
INVESTIGATOR_TIMEOUT_SECONDS=30
INVESTIGATOR_MAX_TOOL_CALLS=4
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_URL=
URLHAUS_AUTH_KEY=
THREAT_INTEL_PROVIDER_MODE=offline
THREAT_INTEL_ENABLE_EXTERNAL_PROVIDERS=false
THREAT_INTEL_LOOKUP_TIMEOUT_SECONDS=5
# Only the offline knowledge provider is implemented.
KNOWLEDGE_BASE_PROVIDER_MODE=offline
KNOWLEDGE_BASE_PATH=knowledge
RAG_TOP_K=5
RAG_MAX_CHUNK_CHARS=1200
RAG_MAX_CONTEXT_CHARS=6000
