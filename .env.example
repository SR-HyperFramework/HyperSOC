# Backend container connects to the Compose service name, not localhost.
DATABASE_URL=postgresql+asyncpg://soc:soc@postgres:5432/soc

# Generate a long random value and configure the same value in Wazuh <api_key>.
# Do not commit the real secret.
APP_SECRET_KEY=replace-with-a-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_RATE_LIMIT_PER_MINUTE=120
INGEST_SIGNATURE_MAX_SKEW_SECONDS=300
INGEST_MAX_BODY_BYTES=1048576

# External Wazuh manager sends outbound HTTPS requests to this published endpoint.
# This is documentation/configuration for the manager, not a backend client URL.
SOC_INGEST_URL=https://soc.example.internal/api/v1/alerts

# Placeholder settings for later roadmap phases.
WAZUH_API_URL=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
WAZUH_ACTIVE_RESPONSE_PROVIDER_MODE=offline
WAZUH_ACTIVE_RESPONSE_AGENTS=all
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set AI_TRIAGE_PROVIDER_MODE=jev to enable TypeSafe System One triage.
# Create the API key at https://console.typesafe.ai and never commit it.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=jev-latest
AI_TRIAGE_PROVIDER_MODE=offline
AI_TRIAGE_TIMEOUT_SECONDS=30
AI_TRIAGE_MAX_ALERTS=25
AI_TRIAGE_MAX_TEXT_CHARS=1000
AI_TRIAGE_MAX_CONTEXT_CHARS=20000
AI_TRIAGE_MAX_JSON_DEPTH=6
AI_TRIAGE_MAX_LIST_ITEMS=50
AI_TRIAGE_BINARY_PLACEHOLDER=[BINARY_DATA_STRIPPED]
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_URL=
THREAT_INTEL_PROVIDER_MODE=offline
THREAT_INTEL_ENABLE_EXTERNAL_PROVIDERS=false
THREAT_INTEL_LOOKUP_TIMEOUT_SECONDS=5
QDRANT_URL=
QDRANT_API_KEY=
KNOWLEDGE_BASE_PROVIDER_MODE=offline
KNOWLEDGE_BASE_PATH=knowledge
RAG_TOP_K=5
RAG_MAX_CHUNK_CHARS=1200
RAG_MAX_CONTEXT_CHARS=6000
